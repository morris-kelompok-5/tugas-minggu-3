# ======================= Kartu satu slot (carousel) =======================
<WeatherSlotCard>:
    orientation: "vertical"
    size_hint: None, None
    size: dp(112), dp(148)
    padding: dp(12)
    spacing: dp(6)
    radius: [dp(20)]
    theme_bg_color: "Custom"
    md_bg_color: "#F5EBDD"

    MDLabel:
        text: root.stamp
        halign: "center"
        bold: True
        font_style: "Label"
        role: "medium"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: "#A18D7A"

    MDIcon:
        icon: root.icon
        pos_hint: {"center_x": .5}
        adaptive_size: True
        theme_text_color: "Custom"
        text_color: "#D87945"
        theme_font_size: "Custom"
        font_size: dp(36)

    MDLabel:
        text: root.temp
        halign: "center"
        font_style: "Title"
        role: "large"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: "#49372D"

    MDLabel:
        text: root.desc
        halign: "center"
        font_style: "Body"
        role: "small"
        shorten: True
        shorten_from: "right"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: "#B49D87"


# ======================= Statistik kecil (kelembapan, angin, awan) =======================
<WeatherStat>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(4)

    MDIcon:
        icon: root.icon
        pos_hint: {"center_x": .5}
        adaptive_size: True
        theme_text_color: "Custom"
        text_color: "#D87945"
        theme_font_size: "Custom"
        font_size: dp(22)

    MDLabel:
        text: root.value
        halign: "center"
        font_style: "Title"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: "#49372D"

    MDLabel:
        text: root.caption
        halign: "center"
        font_style: "Label"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: "#A18D7A"


<ModalCreateProfile>:
    size_hint: None, None
    width: dp(320)
    height: content.height
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.4

    MDBoxLayout:
        id: content
        orientation: "vertical"
        adaptive_height: True
        padding: dp(24)
        spacing: dp(16)
        radius: [dp(24)]
        md_bg_color: app.theme_cls.surfaceContainerColor

        MDLabel:
            text: "Buat Profil"
            font_style: "Title"
            role: "large"
            adaptive_height: True

        MDLabel:
            text: "Isi data dirimu dulu sebelum mulai."
            font_style: "Body"
            role: "medium"
            theme_text_color: "Secondary"
            adaptive_height: True

        MDTextField:
            id: nama

            MDTextFieldHintText:
                text: "Nama"

        MDTextField:
            id: tanggal
            readonly: True
            on_touch_down: root.date_touch_down(self, args[1])
            on_touch_up: root.date_touch_up(self, args[1])

            MDTextFieldHintText:
                text: "Tanggal lahir"

            MDTextFieldTrailingIcon:
                icon: "calendar"

        MDTextField:
            id: berat
            input_filter: "float"

            MDTextFieldHintText:
                text: "Berat badan (kg)"

        MDTextField:
            id: tinggi
            input_filter: "float"

            MDTextFieldHintText:
                text: "Tinggi badan (cm)"

        MDButton:
            style: "filled"
            theme_bg_color: "Custom"
            md_bg_color: "#FF6822"
            size_hint_x: 1
            on_release: root.save()

            MDButtonText:
                text: "Simpan"
                pos_hint: {"center_x": .5, "center_y": .5}


<Home>:
    MDBoxLayout:
        orientation: "vertical"
        padding: [0, dp(40), 0, 0]
        theme_bg_color: "Custom"
        md_bg_color: "#FFF9F0"

        MDScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(20), dp(20), dp(20), dp(200)]
                spacing: dp(18)

                # ===== Judul bagian =====
                MDLabel:
                    text: "CUACA HARI INI"
                    font_style: "Label"
                    role: "medium"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: "#D87945"

                # ===== Kartu cuaca saat ini =====
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(20)
                    spacing: dp(14)
                    radius: [dp(22)]
                    theme_bg_color: "Custom"
                    md_bg_color: "#F5EBDD"

                    # Lokasi + tombol refresh
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        MDIcon:
                            icon: "map-marker-outline"
                            pos_hint: {"center_y": .5}
                            size_hint: None, None
                            size: dp(22), dp(22)
                            theme_text_color: "Custom"
                            text_color: "#D87945"

                        MDLabel:
                            text: root.weather_location
                            font_style: "Body"
                            role: "medium"
                            shorten: True
                            shorten_from: "right"
                            adaptive_height: True
                            pos_hint: {"center_y": .5}
                            theme_text_color: "Custom"
                            text_color: "#49372D"

                        MDIconButton:
                            icon: "refresh"
                            style: "standard"
                            size_hint: None, None
                            size: dp(40), dp(40)
                            pos_hint: {"center_y": .5}
                            theme_icon_color: "Custom"
                            icon_color: "#D87945"
                            on_release: root.refresh_weather(True)

                    # Ikon besar + suhu + kondisi
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(16)

                        MDRelativeLayout:
                            size_hint: None, None
                            size: dp(76), dp(76)
                            pos_hint: {"center_y": .5}
                            radius: [dp(24)]
                            theme_bg_color: "Custom"
                            md_bg_color: "#FCE2CF"

                            MDIcon:
                                icon: root.weather_icon
                                pos_hint: {"center_x": .5, "center_y": .5}
                                adaptive_size: True
                                theme_text_color: "Custom"
                                text_color: "#D87945"
                                theme_font_size: "Custom"
                                font_size: dp(44)

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            pos_hint: {"center_y": .5}

                            MDLabel:
                                text: root.weather_temp
                                font_style: "Display"
                                role: "medium"
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: "#49372D"

                            MDLabel:
                                text: root.weather_desc
                                font_style: "Body"
                                role: "medium"
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: "#A18D7A"

                    MDDivider:
                        color: "#E8D8C5"

                    # Statistik
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)

                        WeatherStat:
                            icon: "water-percent"
                            value: root.weather_hu
                            caption: "Kelembapan"

                        WeatherStat:
                            icon: "weather-windy"
                            value: root.weather_ws
                            caption: "Angin"

                        WeatherStat:
                            icon: "cloud-outline"
                            value: root.weather_tcc
                            caption: "Awan"

                # ===== Carousel prakiraan =====
                MDLabel:
                    text: "PRAKIRAAN 24 JAM"
                    font_style: "Label"
                    role: "medium"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: "#D87945"

                MDScrollView:
                    size_hint_y: None
                    height: dp(156)
                    do_scroll_x: True
                    do_scroll_y: False
                    bar_width: 0

                    MDBoxLayout:
                        id: forecast_row
                        size_hint: None, None
                        adaptive_width: True
                        height: dp(148)
                        spacing: dp(12)

                # ===== Status + atribusi BMKG =====
                MDLabel:
                    text: root.weather_status
                    halign: "center"
                    font_style: "Body"
                    role: "small"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: "#B49D87"