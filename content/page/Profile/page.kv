<Profile>:
    MDBoxLayout:
        orientation: "vertical"
        padding: [0, dp(40), 0, 0]
        spacing: 0
        theme_bg_color: "Custom"
        md_bg_color: "#FFF9F0"

        # =========================
        # HEADER
        # =========================
        MDBoxLayout:
            id: header
            size_hint_y: None
            height: max(self.minimum_height, dp(112))
            padding: [max(dp(24), (self.width - dp(480)) / 2), dp(16), max(dp(20), (self.width - dp(480)) / 2), dp(16)]
            spacing: dp(16)

            canvas.after:
                Color:
                    rgba: 0.91, 0.84, 0.76, 1
                Line:
                    width: dp(1)
                    points: [self.x + self.padding[0], self.y, self.right - self.padding[2], self.y]

            MDRelativeLayout:
                size_hint: None, None
                size: dp(76), dp(76)
                pos_hint: {"center_y": .5}
                radius: [dp(24)]
                theme_bg_color: "Custom"
                md_bg_color: "#F5EBDD"

                MDIcon:
                    icon: "account"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    theme_text_color: "Custom"
                    text_color: "#D87945"
                    theme_font_size: "Custom"
                    font_size: dp(42)

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(3)
                pos_hint: {"center_y": .5}

                MDLabel:
                    text: "PLAYER PROFILE"
                    font_style: "Label"
                    role: "small"
                    theme_text_color: "Custom"
                    text_color: "#D87945"
                    adaptive_height: True

                MDLabel:
                    id: nama
                    text: "NAMA"
                    font_style: "Title"
                    role: "large"
                    theme_text_color: "Custom"
                    text_color: "#49372D"
                    shorten: True
                    shorten_from: "right"
                    max_lines: 1
                    adaptive_height: True

                MDLabel:
                    text: "Your personal character status"
                    font_style: "Body"
                    role: "small"
                    theme_text_color: "Custom"
                    text_color: "#A18D7A"
                    shorten: True
                    shorten_from: "right"
                    max_lines: 1
                    adaptive_height: True

            MDIconButton:
                icon: "cog-outline"
                style: "standard"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"center_y": .5}
                theme_icon_color: "Custom"
                icon_color: "#D87945"
                on_release: root.open_edit_modal()

        # =========================
        # SCROLL CONTENT
        # =========================
        MDScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            bar_color: "#E99A62"
            bar_inactive_color: "#F5EBDD"

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [max(dp(20), (self.width - dp(480)) / 2), dp(20), max(dp(20), (self.width - dp(480)) / 2), dp(200)]
                spacing: dp(18)

                # =========================
                # CHARACTER ATTRIBUTES
                # =========================
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)

                    MDLabel:
                        text: "CHARACTER ATTRIBUTES"
                        font_style: "Label"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: "#D87945"
                        pos_hint: {"center_y": .5}
                        adaptive_height: True

                    MDIcon:
                        icon: "star-four-points"
                        pos_hint: {"center_y": .5}
                        size_hint: None, None
                        size: dp(22), dp(22)
                        theme_text_color: "Custom"
                        text_color: "#E99A62"
                        theme_font_size: "Custom"
                        font_size: dp(20)

                # =========================
                # WEIGHT AND HEIGHT
                # =========================
                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    spacing: dp(12)

                    # WEIGHT
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16)
                        spacing: dp(10)
                        radius: [dp(20)]
                        theme_bg_color: "Custom"
                        md_bg_color: "#F5EBDD"

                        MDRelativeLayout:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [dp(13)]
                            theme_bg_color: "Custom"
                            md_bg_color: "#FCE2CF"

                            MDIcon:
                                icon: "weight-kilogram"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                theme_text_color: "Custom"
                                text_color: "#D87945"
                                theme_font_size: "Custom"
                                font_size: dp(23)

                        MDLabel:
                            text: "WEIGHT"
                            font_style: "Label"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#A18D7A"
                            adaptive_height: True

                        MDLabel:
                            id: berat
                            text: "BB: -"
                            font_style: "Title"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            shorten: True
                            shorten_from: "right"
                            max_lines: 1
                            adaptive_height: True

                        MDLabel:
                            text: "Body attribute"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#B49D87"
                            shorten: True
                            shorten_from: "right"
                            max_lines: 1
                            adaptive_height: True

                    # HEIGHT
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        padding: dp(16)
                        spacing: dp(10)
                        radius: [dp(20)]
                        theme_bg_color: "Custom"
                        md_bg_color: "#F5EBDD"

                        MDRelativeLayout:
                            size_hint: None, None
                            size: dp(40), dp(40)
                            radius: [dp(13)]
                            theme_bg_color: "Custom"
                            md_bg_color: "#FCE2CF"

                            MDIcon:
                                icon: "human-male-height"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                theme_text_color: "Custom"
                                text_color: "#D87945"
                                theme_font_size: "Custom"
                                font_size: dp(23)

                        MDLabel:
                            text: "HEIGHT"
                            font_style: "Label"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#A18D7A"
                            adaptive_height: True

                        MDLabel:
                            id: tinggi
                            text: "TB: -"
                            font_style: "Title"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            shorten: True
                            shorten_from: "right"
                            max_lines: 1
                            adaptive_height: True

                        MDLabel:
                            text: "Body attribute"
                            font_style: "Body"
                            role: "small"
                            theme_text_color: "Custom"
                            text_color: "#B49D87"
                            shorten: True
                            shorten_from: "right"
                            max_lines: 1
                            adaptive_height: True

                # =========================
                # HEALTH STATUS
                # =========================
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(20)
                    spacing: dp(10)
                    radius: [dp(22)]
                    theme_bg_color: "Custom"
                    md_bg_color: "#F5EBDD"

                    # CARD HEADER
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDIcon:
                            icon: "heart-pulse"
                            pos_hint: {"center_y": .5}
                            size_hint: None, None
                            size: dp(24), dp(24)
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            theme_font_size: "Custom"
                            font_size: dp(22)

                        MDLabel:
                            text: "HEALTH STATUS"
                            font_style: "Label"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            pos_hint: {"center_y": .5}
                            adaptive_height: True

                        MDIcon:
                            icon: "star-four-points"
                            pos_hint: {"center_y": .5}
                            size_hint: None, None
                            size: dp(20), dp(20)
                            theme_text_color: "Custom"
                            text_color: "#E99A62"
                            theme_font_size: "Custom"
                            font_size: dp(18)

                    # IMT TITLE
                    MDLabel:
                        text: "Body Mass Index"
                        halign: "center"
                        font_style: "Body"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: "#A18D7A"
                        adaptive_height: True

                    # IMT VALUE
                    MDLabel:
                        id: imt
                        text: "-"
                        halign: "center"
                        font_style: "Display"
                        role: "medium"
                        theme_text_color: "Custom"
                        text_color: "#49372D"
                        padding: [0, dp(12), 0, dp(12)]
                        adaptive_height: True

                    # CATEGORY STATUS
                    MDBoxLayout:
                        adaptive_height: True
                        padding: [dp(12), dp(8), dp(12), dp(8)]
                        radius: [dp(12)]
                        theme_bg_color: "Custom"
                        md_bg_color: "#E99A62"

                        MDLabel:
                            id: kategori
                            text: "STATUS: -"
                            halign: "center"
                            font_style: "Label"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#FFFFFF"
                            adaptive_height: True

                    # DIVIDER
                    MDDivider:
                        color: "#E8D8C5"

                    # BIRTH DATE
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDIcon:
                            icon: "cake-variant-outline"
                            pos_hint: {"center_y": .5}
                            size_hint: None, None
                            size: dp(22), dp(22)
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            theme_font_size: "Custom"
                            font_size: dp(20)

                        MDLabel:
                            id: tanggal_lahir
                            text: "Tanggal lahir: -"
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            pos_hint: {"center_y": .5}
                            adaptive_height: True

                    # AGE
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)

                        MDIcon:
                            icon: "calendar-clock"
                            pos_hint: {"center_y": .5}
                            size_hint: None, None
                            size: dp(22), dp(22)
                            theme_text_color: "Custom"
                            text_color: "#D87945"
                            theme_font_size: "Custom"
                            font_size: dp(20)

                        MDLabel:
                            id: umur
                            text: "Umur: -"
                            font_style: "Body"
                            role: "medium"
                            theme_text_color: "Custom"
                            text_color: "#49372D"
                            pos_hint: {"center_y": .5}
                            adaptive_height: True